# Copy to .env and fill in. NEVER commit the real .env file.
CF_ACCOUNT_ID=            # Cloudflare account id (Workers AI)
CF_API_TOKEN=             # Cloudflare API token (Workers AI)
GOOGLE_CLIENT_ID=         # Google OAuth Desktop client id (YouTube)
GOOGLE_CLIENT_SECRET=     # Google OAuth client secret
YT_REFRESH_TOKEN=         # obtained via /auth page of the shorts server
PEXELS_API_KEY=
PIXABAY_API_KEY=
GROQ_API_KEY=             # optional, captions for AI-image videos
# live stream (VPS only)
STREAM_KEY=               # YouTube persistent stream key
STREAM_HOURS_UTC=18,0     # start hours (UTC), blocks must not cross midnight
STREAM_HOURS=3            # hours per block
